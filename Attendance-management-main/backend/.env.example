PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ams_db

# JWT
JWT_ACCESS_SECRET=super-secret-access-change-in-prod
JWT_REFRESH_SECRET=super-secret-refresh-change-in-prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false   # true only behind HTTPS
COOKIE_SAME_SITE=lax